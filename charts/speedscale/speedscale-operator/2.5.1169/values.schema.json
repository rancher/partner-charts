{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "namespaced": {
      "$schema": "https://json-schema.org/draft-07/schema#",
      "description": "Values for the namespaced Speedscale chart. Every knob here affects only .Release.Namespace; there is deliberately no value that widens the install's scope.",
      "properties": {
        "affinity": {
          "type": "object"
        },
        "apiKeySecret": {
          "description": "Name of a pre-existing Secret. The chart never creates it.",
          "minLength": 1,
          "type": "string"
        },
        "appUrl": {
          "minLength": 1,
          "type": "string"
        },
        "capture": {
          "properties": {
            "enableDiagnostics": {
              "type": "boolean"
            },
            "forwarderServiceName": {
              "minLength": 1,
              "type": "string"
            },
            "reinitializeIptables": {
              "type": "boolean"
            }
          },
          "required": [
            "forwarderServiceName"
          ],
          "type": "object"
        },
        "clusterName": {
          "description": "Cluster name as it appears in the Speedscale dashboard.",
          "minLength": 1,
          "type": "string"
        },
        "deployDemo": {
          "type": "string"
        },
        "dlp": {
          "properties": {
            "config": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "config"
          ],
          "type": "object"
        },
        "enabled": {
          "type": "boolean"
        },
        "filterRule": {
          "type": "string"
        },
        "forwarder": {
          "properties": {
            "byoc": {
              "properties": {
                "bucket": {
                  "type": "string"
                },
                "credentialsSecret": {
                  "type": "string"
                },
                "endpoint": {
                  "type": "string"
                },
                "pathStyle": {
                  "type": "boolean"
                },
                "prefix": {
                  "type": "string"
                },
                "provider": {
                  "enum": [
                    "s3",
                    "gcs",
                    "azureblob"
                  ],
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "serviceAccountAnnotations": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "enabled": {
              "type": "boolean"
            },
            "exporters": {
              "type": "object"
            },
            "primaryTransport": {
              "enum": [
                "aws",
                "cloud",
                "byoc"
              ],
              "type": "string"
            },
            "replicas": {
              "minimum": 0,
              "type": "integer"
            },
            "resources": {
              "type": "object"
            },
            "telemetryInterval": {
              "description": "Go time.Duration String() form, e.g. 1m0s. Copied verbatim into TELEMETRY_INTERVAL.",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "replicas",
            "telemetryInterval",
            "resources"
          ],
          "type": "object"
        },
        "globalAnnotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "globalLabels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "globalPodSecurityContext": {
          "type": "object"
        },
        "globalSecurityContext": {
          "type": "object"
        },
        "image": {
          "properties": {
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ],
              "type": "string"
            },
            "pullSecrets": {
              "items": {
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "registry": {
              "minLength": 1,
              "type": "string"
            },
            "tag": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "registry",
            "tag",
            "pullPolicy"
          ],
          "type": "object"
        },
        "inspector": {
          "properties": {
            "accessLabels": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "enabled": {
              "type": "boolean"
            },
            "jobsEnabled": {
              "type": "boolean"
            },
            "metricsEnabled": {
              "type": "boolean"
            },
            "replicas": {
              "minimum": 0,
              "type": "integer"
            },
            "resources": {
              "type": "object"
            },
            "serviceAccountName": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "replicas",
            "resources"
          ],
          "type": "object"
        },
        "instanceID": {
          "description": "Shared PROCESS_ID for the forwarder and inspector. Empty derives one.",
          "type": "string"
        },
        "kerberos": {
          "properties": {
            "credentialSource": {
              "enum": [
                "keytab",
                "cache"
              ],
              "type": "string"
            },
            "disableFAST": {
              "type": "boolean"
            },
            "enabled": {
              "type": "boolean"
            },
            "principal": {
              "type": "string"
            },
            "proxySPN": {
              "type": "string"
            },
            "secretName": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "secretName",
            "credentialSource",
            "principal",
            "proxySPN",
            "disableFAST"
          ],
          "type": "object"
        },
        "logLevel": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "type": "string"
        },
        "namespaceSelector": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "networkPolicy": {
          "properties": {
            "cloudEgressCIDRs": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "cloudEgressExceptCIDRs": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "enabled": {
              "type": "boolean"
            },
            "extraForwarderIngressFrom": {
              "items": {
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        },
        "nodeSelector": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "pdb": {
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        },
        "replayCoordinator": {
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "leaseEnabled": {
              "type": "boolean"
            },
            "provisioningTimeout": {
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$",
              "type": "string"
            },
            "replicas": {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            "resources": {
              "type": "object"
            },
            "resyncInterval": {
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "replicas",
            "resources"
          ],
          "type": "object"
        },
        "replayRuntime": {
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "metricsEnabled": {
              "type": "boolean"
            },
            "serviceAccountName": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "serviceAccountName"
          ],
          "type": "object"
        },
        "secretAccessList": {
          "description": "Secrets granted individually, by resourceName. Empty means no Secret access at all.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "tenant": {
          "description": "Cloud-issued identity, not configuration. See S-12914.",
          "properties": {
            "bucket": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "stream": {
              "type": "string"
            },
            "subTenantName": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "tls": {
          "properties": {
            "caCommonName": {
              "minLength": 1,
              "type": "string"
            },
            "certsSecret": {
              "description": "Required when create is false.",
              "type": "string"
            },
            "create": {
              "type": "boolean"
            },
            "createJKS": {
              "type": "boolean"
            },
            "jks": {
              "properties": {
                "image": {
                  "minLength": 1,
                  "type": "string"
                },
                "resources": {
                  "type": "object"
                }
              },
              "type": "object"
            },
            "jksSecret": {
              "minLength": 1,
              "type": "string"
            },
            "systemCABundle": {
              "description": "PEM root certificates prepended to ca-certificates.crt. Empty leaves the instrumented application trusting only the Speedscale CA.",
              "type": "string"
            },
            "validityDays": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "create",
            "createJKS"
          ],
          "type": "object"
        },
        "tolerations": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "uninstall": {
          "properties": {
            "cleanupTimeout": {
              "description": "Whole number of h, m or s. Also becomes the Job's activeDeadlineSeconds.",
              "pattern": "^[0-9]+[hms]$",
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "forceCleanupOnUninstall": {
              "type": "boolean"
            },
            "resources": {
              "type": "object"
            }
          },
          "required": [
            "enabled",
            "cleanupTimeout",
            "forceCleanupOnUninstall"
          ],
          "type": "object"
        }
      },
      "required": [
        "clusterName",
        "apiKeySecret",
        "image",
        "forwarder",
        "inspector",
        "replayCoordinator",
        "replayRuntime",
        "capture",
        "tls",
        "uninstall",
        "networkPolicy",
        "pdb"
      ],
      "title": "speedscale-namespaced values",
      "type": "object"
    }
  },
  "type": "object"
}