{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harikube Helm Values Schema",
  "type": "object",
  "properties": {
    "enterprise": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "user": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "mutatingAdmissionPolicy": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "middleware": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "monitoring": { "$ref": "#/definitions/componentMonitoring" },
        "networkPolicy": { "$ref": "#/definitions/componentNetworkPolicy" },
        "image": { "$ref": "#/definitions/containerImage" },
        "env": {
          "type": "array",
          "items": { "$ref": "#/definitions/envVar" }
        },
        "endPoint": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "caPEM": { "type": "string" },
            "certPEM": { "type": "string" },
            "keyPEM": { "type": "string" },
            "skipVerify": { "type": "boolean" }
          }
        },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "service": {
          "type": "object",
          "properties": {
            "apiPort": { "$ref": "#/definitions/serviceConfig" },
            "metrics": { "$ref": "#/definitions/serviceConfig" }
          }
        },
        "resources": { "type": "object" },
        "livenessProbe": { "type": "object" },
        "readinessProbe": { "type": "object" },
        "volumes": { "type": "array", "items": { "type": "object" } },
        "volumeMounts": { "type": "array", "items": { "type": "object" } },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "pvc": {
          "type": "object",
          "properties": {
            "accessModes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "resources": { "type": "object" },
            "storageClassName": { "type": "string" }
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "monitoring": { "$ref": "#/definitions/componentMonitoring" },
        "networkPolicy": { "$ref": "#/definitions/componentNetworkPolicy" },
        "image": { "$ref": "#/definitions/containerImage" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "service": {
          "type": "object",
          "properties": {
            "webhook": { "$ref": "#/definitions/serviceConfig" },
            "metrics": { "$ref": "#/definitions/serviceConfig" }
          }
        },
        "resources": { "type": "object" },
        "livenessProbe": { "type": "object" },
        "readinessProbe": { "type": "object" },
        "volumes": { "type": "array", "items": { "type": "object" } },
        "volumeMounts": { "type": "array", "items": { "type": "object" } },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "serviceAccount": { "type": "object" }
      }
    },
    "apiServer": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "monitoring": { "$ref": "#/definitions/componentMonitoring" },
        "networkPolicy": { "$ref": "#/definitions/componentNetworkPolicy" },
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/containerImage" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "service": {
          "type": "object",
          "properties": {
            "apiServer": { "$ref": "#/definitions/serviceConfig" }
          }
        },
        "resources": { "type": "object" },
        "volumes": { "type": "array", "items": { "type": "object" } },
        "volumeMounts": { "type": "array", "items": { "type": "object" } },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    },
    "controllerManager": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "monitoring": { "$ref": "#/definitions/componentMonitoring" },
        "networkPolicy": { "$ref": "#/definitions/componentNetworkPolicy" },
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/containerImage" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "service": {
          "type": "object",
          "properties": {
            "https": { "$ref": "#/definitions/serviceConfig" }
          }
        },
        "resources": { "type": "object" },
        "volumes": { "type": "array", "items": { "type": "object" } },
        "volumeMounts": { "type": "array", "items": { "type": "object" } },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    },
    "vcluster": {
      "type": "object",
      "properties": {
        "controlPlane": { "type": "object" },
        "exportKubeConfig": {
          "type": "object",
          "properties": {
            "context": { "type": "string" },
            "server": { "type": "string" }
          }
        },
        "sync": { "type": "object" },
        "networking": { "type": "object" }
      }
    }
  },
  "definitions": {
    "containerImage": {
      "type": "object",
      "properties": {
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "Never", "IfNotPresent"]
        },
        "tag": { "type": "string" },
        "repository": { "type": "string" },
        "registry": { "type": "string" }
      }
    },
    "componentMonitoring": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "componentNetworkPolicy": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "serviceConfig": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "envVar": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  }
}